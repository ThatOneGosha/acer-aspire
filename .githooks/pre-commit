#!/usr/bin/env -S uv run --script
# /// script
# requires-python = "==3.14.10"
# dependencies = [
#     "ensure-sops @ git+https://github.com/tacto-ai/ensure-sops",
#     "loguru==0.8.0",
#     "plumbum==2.0.2"
# ]
# ///

from pathlib import Path

from loguru import logger
from plumbum import cmd


def main() -> int:
  files = [
      str(p)
      for p in Path("secrets").rglob("*")
      if p.is_file() and p.suffix in {".yaml", ".yml", ".json", ".env", ".ini"}
  ]

  ok = True
  for f in files:
    rc, _, err = cmd.sops.run(["-d", f], retcode=None)
    if rc != 0:
      ok = False
      logger.error(f"[{f}] {err.strip()}")

  if not ok:
    return 1

  if files:
    logger.success(f"SOPS OK ({len(files)} file(s))")
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
