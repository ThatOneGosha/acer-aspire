#!/usr/bin/env -S uv run --script
# /// script
# requires-python = "==3.14.10"
# dependencies = [
#     "ensure-sops @ git+https://github.com/tacto-ai/ensure-sops",
#     "loguru==0.8.0",
#     "plumbum==2.0.2"
# ]
# ///

from dataclasses import dataclass, field
import re

from loguru import logger
from plumbum import FG, ProcessExecutionError, cmd


@dataclass(frozen=True)
class HookState:
  pattern: str = r"^secrets/.*\.(yaml|yml|json|env|ini)$"
  staged: list[str] = field(
      default_factory=lambda: cmd.git(
          "diff", "--cached", "--name-only", "--diff-filter=ACM"
      ).splitlines()
  )

  @property
  def secret_files(self) -> list[str]:
    return [f for f in self.staged if re.match(self.pattern, f)]


def main() -> int:
  state = HookState()

  if not state.secret_files:
    logger.success("No secret files have been changed.")
    return 0

  try:
    cmd.ensure_sops[state.secret_files] & FG
    logger.success("Secret files encryption verified.")
    return 0
  except ProcessExecutionError as e:
    logger.error(e)
    return 1


if __name__ == "__main__":
  raise SystemExit(main())
