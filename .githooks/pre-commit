#!/usr/bin/env -S uv run --script
# /// script
# requires-python = "==3.14.10"
# dependencies = [
#     "ensure-sops @ git+https://github.com/tacto-ai/ensure-sops",
#     "loguru==0.8.0",
#     "plumbum==2.0.2"
# ]
# ///


from dataclasses import dataclass, field
import re

from loguru import logger
from plumbum import FG, ProcessExecutionError, cmd


@dataclass(frozen=True)
class HookState:
  files: list[str] = field(
      default_factory=lambda: [
          f
          for f in cmd.git(
              "diff", "--cached", "--name-only", "--diff-filter=ACM"
          ).splitlines()
          if re.match(r"^secrets/.*\.(yaml|yml|json|env|ini)$", f)
      ]
  )


def main() -> int:
  state = HookState()
  if not state.files:
    return 0

  try:
    cmd.ensure_sops[state.files] & FG
    logger.success(f"SOPS OK ({len(state.files)} file(s))")
    return 0
  except ProcessExecutionError:
    return 1


if __name__ == "__main__":
  raise SystemExit(main())

