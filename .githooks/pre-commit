#!/usr/bin/env -S uv run --script
# /// script
# requires-python = "==3.14.10"
# dependencies = [
#     "ensure-sops @ git+https://github.com/tacto-ai/ensure-sops",
#     "loguru==0.8.0",
#     "plumbum==2.0.2",
#     "isort==9.0.2",
#     "yapf==0.43.0"
# ]
# ///


import re

from loguru import logger
from plumbum import FG, ProcessExecutionError, cmd


def main() -> int:
    diff_args = ("diff", "--cached", "--name-only", "--diff-filter=ACM")
    staged = cmd.git(*diff_args).splitlines()

    secret_re = re.compile(r"^secrets/.*\.(yaml|yml|json|env|ini)$")
    secret_files = [p for p in staged if secret_re.match(p)]
    py_files = [p for p in staged if p.endswith(".py")]

    try:
        if py_files:
            cmd.isort["--check-only", "--diff", py_files] & FG
            cmd.yapf["--diff", py_files] & FG

        if secret_files:
            cmd.ensure_sops[secret_files] & FG
    except ProcessExecutionError:
        return 1

    if py_files or secret_files:
        logger.success("Pre-commit checks passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
