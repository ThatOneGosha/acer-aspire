#!/usr/bin/env -S uv run --script
# /// script
# requires-python = "==3.14.10"
# dependencies = [
#     "ensure-sops @ git+https://github.com/tacto-ai/ensure-sops",
#     "loguru==0.8.0",
#     "plumbum==2.0.2"
# ]
# ///


import re
from dataclasses import dataclass
from loguru import logger
from plumbum import FG, ProcessExecutionError
from plumbum import cmd

@dataclass(frozen=True)
class State:
  pattern: str = r"^secrets/.*\.(yaml|yml|json|env|ini)$"
  staged = cmd.git("diff", "--cached", "--name-only", "--diff-filter=ACM").splitlines()

def main() -> int:
  state = State()
  logger.info(f"Staged files: {state.staged}")
  secret_files = [f for f in state.staged if re.match(state.pattern, f)]

  if not secret_files:
    return 0

  try:
    cmd.ensure_sops[secret_files] & FG
    logger.success("SOPS check passed")
    return 0
  except ProcessExecutionError:
    logger.error("Unencrypted secret detected!")
    return 1


if __name__ == "__main__":
  raise SystemExit(main())
