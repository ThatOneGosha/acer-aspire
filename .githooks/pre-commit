#!/usr/bin/env -S uv run --script
# /// script
# requires-python = "==3.14.10"
# dependencies = [
#     "ensure-sops @ git+https://github.com/tacto-ai/ensure-sops",
#     "loguru==0.8.0",
#     "plumbum==2.0.2"
# ]
# ///

import re

from loguru import logger
from plumbum import cmd


def main() -> int:
  staged = cmd.git(
      "diff", "--cached", "--name-only", "--diff-filter=ACM"
  ).splitlines()
  files = [
      f for f in staged if re.match(r"^secrets/.*\.(yaml|yml|json|env|ini)$", f)
  ]

  ok = True
  for f in files:
    rc, _, err = cmd.sops.run(["-d", f], retcode=None)
    if rc != 0:
      ok = False
      logger.error(f"[{f}] {err.strip()}")

  if not ok:
    return 1

  if files:
    logger.success(f"SOPS OK ({len(files)} file(s))")
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
