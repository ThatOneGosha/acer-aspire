#!/usr/bin/env -S uv run --script
# /// script
# requires-python = "==3.14.10"
# dependencies = [
#     "ensure-sops @ git+https://github.com/tacto-ai/ensure-sops",
#     "loguru==0.8.0",
#     "plumbum==2.0.2"
# ]
# ///

from dataclasses import dataclass, field
import re

from loguru import logger
from plumbum import cmd


@dataclass(frozen=True)
class HookState:
  pattern: str = r"^secrets/.*\.(yaml|yml|json|env|ini)$"
  staged: list[str] = field(
      default_factory=lambda: cmd.git(
          "diff", "--cached", "--name-only", "--diff-filter=ACM"
      ).splitlines()
  )

  @property
  def secret_files(self) -> list[str]:
    return [f for f in self.staged if re.match(self.pattern, f)]


def main() -> int:
  state = HookState()
  if not state.secret_files:
    return 0

  ok = True
  for path in state.secret_files:
    retcode, stdout, stderr = cmd.ensure_sops.run([path], retcode=None)
    if retcode == 0:
      continue

    ok = False
    output = f"{stdout}\n{stderr}".strip()

    if "ScannerError" in output or "ParserError" in output:
      tail = "\n".join(output.splitlines()[-6:])
      logger.error(f"[{path}] Corrupted YAML/JSON syntax:\n{tail}")
    else:
      logger.error(f"[{path}] {output}")

  if not ok:
    return 1

  logger.success(f"SOPS check passed ({len(state.secret_files)} file(s))")
  return 0

